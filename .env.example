# Luminal Cloud (required for all reported numbers)
# OpenAI-compatible endpoint; the key serves deepseek-ai/DeepSeek-V4.1-Flash with logprobs.
LUMINAL_BASE_URL=https://luminal.cloud/v1
LUMINAL_API_KEY=
GENERATOR_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
REFLECTOR_MODEL=
CURATOR_MODEL=

# Local inference instead of Luminal: any OpenAI-compatible server on your own hardware
# (Ollama, llama.cpp llama-server, vLLM, LM Studio). Local runs are never reportable,
# and the safety gate only auto-applies after `python -m forkward calibrate` for that model.
LLM_PROVIDER=
# DeepSeek's own API (LLM_PROVIDER=deepseek, or model specs like deepseek:deepseek-chat).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Gemini's OpenAI-compatible API (model specs like gemini:gemini-2.5-flash). Calibrate before use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=
LOCAL_API_KEY=

# Postgres (any managed Postgres, such as Neon or Tiger Cloud). Use the pooled connection string with sslmode=require, and a
# role that is not a superuser, so row-level security applies. Apply the schema with
# `python -m forkward db migrate`, which also creates the web app's Better Auth tables. Optional for
# local benchmark runs, which always write JSONL. The web app needs it.
DATABASE_URL=

# Stripe Billing. The hosted service reports units to the meter named STRIPE_METER_EVENT with
# `python -m forkward keys report-usage` (deploy/forkward-billing.timer runs it every five minutes).
# The web app starts Checkout with one flat monthly price and one metered price per plan, and
# its webhook (https://<host>/api/stripe/webhook) writes the plan a tenant is on.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_EVENT=forkward_hunks
STRIPE_PRICE_TEAM_BASE=
STRIPE_PRICE_TEAM_METERED=
STRIPE_PRICE_ENTERPRISE_BASE=
STRIPE_PRICE_ENTERPRISE_METERED=

# Frozen benchmark repository (forkward-data) on the build machine
DATA_DIR=

# Build and test commands run untrusted code (build.rs, proc macros, tests). Only
# `cargo build|check|test` with plain flags is accepted. By default (empty or docker) they run in a
# container with no network, only the worktree mounted writable and no secrets in the environment.
# gvisor does the same under gVisor's runsc runtime (install runsc first). env runs them on this
# machine with only a scrubbed environment and resource caps, so build code can still read your
# files (this .env included) and use the network: use it only for repositories you trust.
# FORKWARD_HOSTED=1 marks the shared hosted service: it never runs a build and never pushes.
FORKWARD_SANDBOX=
FORKWARD_SANDBOX_IMAGE=rust:1-slim
FORKWARD_SANDBOX_MEMORY_MB=16384
FORKWARD_HOSTED=

# Operator token for the board. Approvals, starting the demo preview, listing models and changing
# the model need `Authorization: Bearer <BOARD_ADMIN_TOKEN>`. Set it on any shared deployment.
BOARD_ADMIN_TOKEN=
# Shared by the web app and the board so only the web app can preview a signed-in user's fork.
# Without it, both derive the secret from DATABASE_URL.
PREVIEW_SECRET=

# Optional: a token for the bot identity (the forkward-bot GitHub App replaces this). When set,
# open_sync_pr pushes and opens PRs as the bot; otherwise it uses your git credentials and gh login.
GITHUB_TOKEN=

# Run settings
MAX_LLM_CONCURRENCY=8
# Luminal accepts about 120 requests per minute per key; pace below it.
LLM_RPM=100
REQUEST_TIMEOUT_SECONDS=90
POPULATION_SIZE=6
LEARNING_ROUNDS=5
PLAYBOOK_MAX_LESSONS=12
TARGET_ESCAPED_ERROR=0.05
CONFIDENCE_LEVEL=0.95
BOOTSTRAP_RESAMPLES=10000
# Research protocol. Seeds salt every sampling call and the validation split;
# promotion spends PROMOTION_ALPHA evenly over the planned rounds.
SAMPLING_SEED=0
VALIDATION_SPLIT_SEED=0
PROMOTION_ALPHA=0.05

# Reasoning on Luminal DeepSeek Flash. Off by default because reasoning runs past the ~20 s gateway limit.
LLM_THINKING=off

# Web app sign-in (Better Auth). BETTER_AUTH_SECRET signs sessions and encrypts stored GitHub
# tokens; generate one with `openssl rand -base64 32`. BETTER_AUTH_URL is the public origin, such as
# https://forkward.example or http://localhost:3000. It is also the OAuth issuer base for the hosted
# MCP server, whose resource URL is <BETTER_AUTH_URL>/mcp.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The forkward-bot GitHub App. Its client id and secret also serve "Continue with GitHub", which is
# the only way to sign in. Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github. Setup URL:
# <BETTER_AUTH_URL>/api/github/installed. GITHUB_APP_SLUG is the name in github.com/apps/<slug>.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Server side of the same app: the sync worker mints repository-scoped installation tokens with
# the app's private key, and the MCP server verifies webhook deliveries at
# <public origin>/github/webhook with GITHUB_WEBHOOK_SECRET.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# The hosted MCP endpoint, used as the OAuth audience. Defaults to <BETTER_AUTH_URL>/mcp.
FORKWARD_MCP_URL=

# Tracing (OpenTelemetry). Langfuse Cloud keys send model-call and workflow spans to Langfuse;
# any OTLP backend works through OTEL_EXPORTER_OTLP_TRACES_ENDPOINT and _HEADERS instead.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
