[Unit]
Description=Forkward observability board (read-only API for the frontend)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__HOME__/forkward
Environment=BOARD_READONLY=1 FORKWARD_HOSTED=1
ExecStart=__HOME__/forkward/.venv/bin/python dashboard/server.py --port 8765
Restart=always
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=__HOME__/forkward __HOME__/.forkward
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
