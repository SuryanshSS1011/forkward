   "",
   "\t\t\tdwc3_writel(dwc->regs, DWC3_GRXTHRCFG, reg);",
   "\t\t}",
   "",
   "\t\tif (tx_thr_num && tx_maxburst) {",
   "\t\t\treg = dwc3_readl(dwc->regs, DWC3_GTXTHRCFG);",
   "\t\t\treg |= DWC31_GTXTHRCFG_PKTCNTSEL;",
