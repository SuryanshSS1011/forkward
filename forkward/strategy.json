 "playbook": {
  "version": "pb-0a415454",
  "parent": "pb-777f0c67",
  "lessons": [
   {
    "id": "L4290",
    "text": "A conflict where the vendor side is empty usually means the vendor intentionally dropped that content, so the empty side should win.",
    "helpful": 135,
    "harmful": 36,
    "round": 1
   },
   {
    "id": "L4dec",
    "text": "When a vendor has restructured or renamed a driver into new files, treat the vendor layout as authoritative and do not re-import upstream hunks that assume the old structure.",
    "helpful": 0,
    "harmful": 0,
    "round": 1
   },
   {
    "id": "L07c9",
    "text": "If the vendor deliberately removed or replaced a block that upstream still modifies, keep the vendor version rather than reintroducing the upstream code.",
    "helpful": 0,
    "harmful": 0,
    "round": 1
   },
   {
    "id": "L17e3",
    "text": "When upstream and vendor changes touch the same logical area but the vendor has already absorbed the upstream fix in its own form, prefer the vendor's final state over replaying the upstream delta.",
    "helpful": 0,
    "harmful": 0,
    "round": 1
   },
   {
    "id": "L1dc8",
    "text": "When upstream restructures a block that the vendor also modified, keep the vendor's added behavior but reapply it inside the upstream's new structure rather than discarding either side.",
    "helpful": 0,
    "harmful": 0,
    "round": 4
   },
   {
    "id": "L7316",
    "text": "A small upstream fix that corrects an off-by-one or boundary condition must be carried into the vendor's version even when the vendor's surrounding code differs.",
    "helpful": 0,
    "harmful": 0,
    "round": 4
   },
   {
    "id": "L4ad5",
    "text": "When upstream renames, reorders, or splits a definition that the vendor also changed, adopt the upstream naming and placement while preserving the vendor's functional additions.",
    "helpful": 0,
    "harmful": 0,
    "round": 4
   },
   {
    "id": "La115",
    "text": "If the vendor's change is a superset or generalization of the upstream change, take the upstream form and layer the vendor's extra logic on top instead of keeping the vendor's older form.",
    "helpful": 0,
    "harmful": 0,
    "round": 4
   }
  ]
 },
