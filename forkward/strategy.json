   "#ifdef CONFIG_OF",
   "struct dwc3_cache_type {",
   "\tu8 transfer_type_datard;",
   "\tu8 transfer_type_descrd;",
   "\tu8 transfer_type_datawr;",
   "\tu8 transfer_type_descwr;",
   "};",
   "",
   "static const struct dwc3_cache_type ls1088a_dwc3_cache_type = {",
   "\t.transfer_type_datard = 2,",
   "\t.transfer_type_descrd = 2,",
   "\t.transfer_type_datawr = 2,",
   "\t.transfer_type_descwr = 2,",
   "};",
   "",
   "/**",
   " * dwc3_set_cache_type - Configure cache type registers",
   " * @dwc: Pointer to our controller context structure",
   " */",
   "static void dwc3_set_cache_type(struct dwc3 *dwc)",
   "{",
   "\tu32 tmp, reg;",
   "\tconst struct dwc3_cache_type *cache_type =",
   "\t\tdevice_get_match_data(dwc->dev);",
   "",
   "\tif (cache_type) {",
   "\t\treg = dwc3_readl(dwc->regs,  DWC3_GSBUSCFG0);",
   "\t\ttmp = reg;",
   "",
   "\t\treg &= ~DWC3_GSBUSCFG0_DATARD(~0);",
   "\t\treg |= DWC3_GSBUSCFG0_DATARD(cache_type->transfer_type_datard);",
   "",
   "\t\treg &= ~DWC3_GSBUSCFG0_DESCRD(~0);",
   "\t\treg |= DWC3_GSBUSCFG0_DESCRD(cache_type->transfer_type_descrd);",
   "",
   "\t\treg &= ~DWC3_GSBUSCFG0_DATAWR(~0);",
   "\t\treg |= DWC3_GSBUSCFG0_DATAWR(cache_type->transfer_type_datawr);",
   "",
   "\t\treg &= ~DWC3_GSBUSCFG0_DESCWR(~0);",
   "\t\treg |= DWC3_GSBUSCFG0_DESCWR(cache_type->transfer_type_descwr);",
   "",
   "\t\tif (tmp != reg)",
   "\t\t\tdwc3_writel(dwc->regs, DWC3_GSBUSCFG0, reg);",
   "\t}",
   "}",
   "#endif",
   "static void dwc3_config_threshold(struct dwc3 *dwc)",
   "{",
   "\tu32 reg;",
   "\tu8 rx_thr_num;",
   "\tu8 rx_maxburst;",
   "\tu8 tx_thr_num;",
   "\tu8 tx_maxburst;",
   "",
   "\t/*",
   "\t * Must config both number of packets and max burst settings to enable",
   "\t * RX and/or TX threshold.",
   "\t */",
   "\tif (!DWC3_IP_IS(DWC3) && dwc->dr_mode == USB_DR_MODE_HOST) {",
   "\t\trx_thr_num = dwc->rx_thr_num_pkt_prd;",
   "\t\trx_maxburst = dwc->rx_max_burst_prd;",
   "\t\ttx_thr_num = dwc->tx_thr_num_pkt_prd;",
   "\t\ttx_maxburst = dwc->tx_max_burst_prd;",
   "",
   "\t\tif (rx_thr_num && rx_maxburst) {",
   "\t\t\treg = dwc3_readl(dwc->regs, DWC3_GRXTHRCFG);",
   "\t\t\treg |= DWC31_RXTHRNUMPKTSEL_PRD;",
   "",
   "\t\t\treg &= ~DWC31_RXTHRNUMPKT_PRD(~0);",
   "\t\t\treg |= DWC31_RXTHRNUMPKT_PRD(rx_thr_num);",
   "",
   "\t\t\treg &= ~DWC31_MAXRXBURSTSIZE_PRD(~0);",
   "\t\t\treg |= DWC31_MAXRXBURSTSIZE_PRD(rx_maxburst);",
   "",
   "\t\t\tdwc3_writel(dwc->regs, DWC3_GRXTHRCFG, reg);",
   "\t\t}",
   "",
   "\t\tif (tx_thr_num && tx_maxburst) {",
   "\t\t\treg = dwc3_readl(dwc->regs, DWC3_GTXTHRCFG);",
   "\t\t\treg |= DWC31_TXTHRNUMPKTSEL_PRD;",
   "",
   "\t\t\treg &= ~DWC31_TXTHRNUMPKT_PRD(~0);",
   "\t\t\treg |= DWC31_TXTHRNUMPKT_PRD(tx_thr_num);",
   "",
   "\t\t\treg &= ~DWC31_MAXTXBURSTSIZE_PRD(~0);",
   "\t\t\treg |= DWC31_MAXTXBURSTSIZE_PRD(tx_maxburst);",
   "",
   "\t\t\tdwc3_writel(dwc->regs, DWC3_GTXTHRCFG, reg);",
   "\t\t}",
   "\t}",
   "",
   "\trx_thr_num = dwc->rx_thr_num_pkt;",
   "\trx_maxburst = dwc->rx_max_burst;",
   "\ttx_thr_num = dwc->tx_thr_num_pkt;",
   "\ttx_maxburst = dwc->tx_max_burst;",
   "",
   "\tif (DWC3_IP_IS(DWC3)) {",
   "\t\tif (rx_thr_num && rx_maxburst) {",
   "\t\t\treg = dwc3_readl(dwc->regs, DWC3_GRXTHRCFG);",
   "\t\t\treg |= DWC3_GRXTHRCFG_PKTCNTSEL;",
   "",
   "\t\t\treg &= ~DWC3_GRXTHRCFG_RXPKTCNT(~0);",
   "\t\t\treg |= DWC3_GRXTHRCFG_RXPKTCNT(rx_thr_num);",
   "",
   "\t\t\treg &= ~DWC3_GRXTHRCFG_MAXRXBURSTSIZE(~0);",
   "\t\t\treg |= DWC3_GRXTHRCFG_MAXRXBURSTSIZE(rx_maxburst);",
   "",
   "\t\t\tdwc3_writel(dwc->regs, DWC3_GRXTHRCFG, reg);",
   "\t\t}",
   "",
   "\t\tif (tx_thr_num && tx_maxburst) {",
   "\t\t\treg = dwc3_readl(dwc->regs, DWC3_GTXTHRCFG);",
   "\t\t\treg |= DWC3_GTXTHRCFG_PKTCNTSEL;",
   "",
   "\t\t\treg &= ~DWC3_GTXTHRCFG_TXPKTCNT(~0);",
   "\t\t\treg |= DWC3_GTXTHRCFG_TXPKTCNT(tx_thr_num);",
   "",
   "\t\t\treg &= ~DWC3_GTXTHRCFG_MAXTXBURSTSIZE(~0);",
   "\t\t\treg |= DWC3_GTXTHRCFG_MAXTXBURSTSIZE(tx_maxburst);",
   "",
   "\t\t\tdwc3_writel(dwc->regs, DWC3_GTXTHRCFG, reg);",
   "\t\t}",
   "\t} else {",
   "\t\tif (rx_thr_num && rx_maxburst) {",
   "\t\t\treg = dwc3_readl(dwc->regs, DWC3_GRXTHRCFG);",
   "\t\t\treg |= DWC31_GRXTHRCFG_PKTCNTSEL;",
   "",
   "\t\t\treg &= ~DWC31_GRXTHRCFG_RXPKTCNT(~0);",
   "\t\t\treg |= DWC31_GRXTHRCFG_RXPKTCNT(rx_thr_num);",
   "",
   "\t\t\treg &= ~DWC31_GRXTHRCFG_MAXRXBURSTSIZE(~0);",
